{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://fjybggorcizszcpedjbb.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "citadeltwin",
      "version": "0.1.0",
      "title": "citadeltwin"
    },
    "tools": [
      {
        "name": "list_projects",
        "title": "List projects",
        "description": "List the signed-in user's CitadelTwin projects, newest first, with id, name and description.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Maximum number of projects to return (default 25)."
            },
            "search": {
              "type": "string",
              "description": "Optional case-insensitive filter on the project name."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_project",
        "title": "Create project",
        "description": "Create a new CitadelTwin project owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Project name."
            },
            "description": {
              "type": "string",
              "description": "Optional project description."
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_blueprint_uploads",
        "title": "List blueprint uploads",
        "description": "List blueprint files the signed-in user has uploaded, optionally filtered to a single project.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "project_id": {
              "type": "string",
              "description": "Optional project id to filter uploads by."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of uploads to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_compliance_violations",
        "title": "List compliance violations",
        "description": "List building-code compliance violations visible to the signed-in user, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "upload_id": {
              "type": "string",
              "description": "Optional blueprint upload id to filter violations by."
            },
            "severity": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "description": "Optional severity filter."
            },
            "limit": {
              "type": "integer",
              "description": "Maximum number of violations to return (default 25)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
